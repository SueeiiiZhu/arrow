# 父级 escape_arrows/.gitignore 已经全局忽略 node_modules/ dist/ .DS_Store
# 等条目；这里只列出 app 内特有的产物，方便单独 clone 此目录时也生效。

# Dependencies / build outputs
node_modules/
dist/
*.tsbuildinfo

# Generated sources (regenerated by `pnpm -F @ea/wxgame gen`)
packages/wxgame/src/levels.generated.ts

# Procedurally generated levels — deterministic from a seed, regenerate
# on demand; never commit (and NEVER move into levels_data/).
packages/tools/generated/

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp
*.swo
*.log

# Tooling cache
coverage/
.eslintcache
.cache/
